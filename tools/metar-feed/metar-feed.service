[Unit]
Description=Fetch METAR and publish JSON for BOXRADAR
Documentation=https://aviationweather.gov/data/api/
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Runs as root purely to write into the lighttpd document root. It is a
# short-lived stdlib-only script that writes exactly one file via atomic
# rename; this avoids changing ownership of a web root that other things on
# the receiver may also be using.
User=root
ExecStart=/usr/local/bin/metar_feed.py
Nice=10
# Upstream being down must never take the timer with it — the previous
# metar.json stays in place and the firmware ages it via the "t" field.
SuccessExitStatus=0 1

# Light hardening: it needs outbound HTTPS and one directory, nothing else.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/www/html

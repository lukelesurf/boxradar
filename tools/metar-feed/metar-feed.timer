[Unit]
Description=Refresh METAR for BOXRADAR every 5 minutes

[Timer]
# METARs are issued half-hourly (plus SPECI on significant change), so this
# is oversampling — deliberately. It costs one 800-byte request and keeps
# worst-case staleness to 5 minutes rather than 30.
OnBootSec=1min
OnUnitActiveSec=5min
AccuracySec=30s
# Catch up after downtime so a rebooted Pi publishes immediately rather
# than waiting out the interval with a stale or absent file.
Persistent=true

[Install]
WantedBy=timers.target

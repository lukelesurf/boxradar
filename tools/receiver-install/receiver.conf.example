# BOXRADAR receiver configuration — example.
#
# Copy to /etc/boxradar/receiver.conf and fill in, or let install.sh prompt
# for these and write it for you. The real file is 0600 and must never be
# committed: it carries feeder credentials.

# "adsb", not "boxradar": BOXRADAR is the ESP32 display — the radar in a box
# — and this machine is just the receiver feeding it. It also keeps the two
# apart on the network: the display answers to boxradar.local via mDNS and
# this box installs avahi too, so a receiver called "boxradar" would race it.
HOSTNAME="adsb"

# Receiver position, decimal degrees. Used by readsb, every feeder and the
# map. Get it from the aerial's location, not the house's postcode — and
# from the aerial's *current* location: moving the mast moves this.
LAT="51.8850413"
LON="0.2350632"
# Aerial height above mean sea level, whole feet. MLAT needs this.
ALT_FT="348"

# 'auto', or a number from `rtl_test` if you have tuned it by hand.
GAIN="auto"
PPM="0"

# The 1090 dongle, by rtl-sdr index or serial (`rtl_test` lists both). Use the
# serial on a box with more than one dongle: indexes follow USB order.
SDR_DEVICE="0"

# Blank for DHCP.
STATIC_IP=""

# Nearest airport with a METAR, 4-letter ICAO. Runway headings for the active
# runway readout are derived from this automatically.
METAR_STATION="EGSS"
# Below this windspeed, no runway is recommended.
CALM_KT="7"

# Feeder credentials. Leave ADSBX_UUID blank on a new box — the ADSBExchange
# installer generates one. On a rebuild, restore the old value here to keep
# your existing statistics.
ADSBX_USER=""
ADSBX_UUID=""

# adsb.lol. Blank ADSBLOL_USER means don't feed them at all — nothing is
# installed and no time daemon is changed. Set it and stage 40 installs their
# feeder, which also grants access to https://re-api.adsb.lol, the whole
# network's unfiltered readsb API. That is authorised by your station's source
# IP, not a key, so anything sharing this box's public address can query it.
#
# Note it installs chrony, replacing systemd-timesyncd. Deliberate — MLAT is
# timing — but it is a system-wide change, so it is called out here rather
# than discovered later.
ADSBLOL_USER=""
# Leave blank on a new box, as with ADSBX_UUID.
ADSBLOL_UUID=""

# adsb.fi. Same deal: blank ADSBFI_USER means don't feed them, nothing is
# installed. Set it and stage 40 installs their feeder, which also opens
# https://opendata.adsb.fi/api/v2/snapshot — every aircraft the network sees,
# refreshed twice a minute, open only to feeder IPs. Rate limited to one
# request per 30 seconds, and a rejected request counts against that.
#
# Also installs chrony if adsb.lol has not already, for the same reason.
ADSBFI_USER=""
# Leave blank on a new box, as with ADSBX_UUID.
ADSBFI_UUID=""

# AeroDataBox. Blank AERODATABOX_USER means don't feed them. Set it and the
# main readsb gains a connector to feed.aerodatabox.com and stage 40 installs
# an MLAT client — no feedclient, nothing else. Feeding earns API credits once
# the receiver is claimed on aerodatabox.com. Needs chrony, as above.
AERODATABOX_USER=""
# Leave blank: install.sh mints one. Keep it afterwards — a new uuid is a new
# receiver, and the credits stay with the old one.
AERODATABOX_UUID=""

FR24_KEY=""

[Unit]
Description=BOXRADAR site configuration UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Unlike boxradar-site, this one writes: the selection it owns, a git checkout
# of the airspace source, and the blob lighttpd serves. StateDirectory and
# CacheDirectory give a DynamicUser service writable directories of its own,
# so the installer needs no chown and nothing is left behind if it is removed.
DynamicUser=yes
StateDirectory=boxradar-config
CacheDirectory=boxradar-config
# ReadWritePaths below lifts systemd's read-only mount over the document root,
# but it does not touch POSIX ownership — the directory is root-owned, so the
# dynamic user still needs a group to write in it. install.sh creates this
# group and gives the document root group-write.
SupplementaryGroups=boxradar-pub
Environment=PYTHONPATH=/usr/local/lib/boxradar-site
Environment=PYTHONUNBUFFERED=1
Environment=BOXRADAR_CONFIG_SELECTION=/var/lib/boxradar-config/selection.json
Environment=BOXRADAR_CONFIG_CACHE=/var/cache/boxradar-config
Environment=BOXRADAR_CONFIG_BLOB=/var/www/html/site.bin
# The display service, for the Device page. It is the only thing on this Pi
# the board talks to, so it is the only thing that knows the board's address.
# Reached over HTTP rather than by import, which keeps the two units genuinely
# independent — and it is why there is no After= on boxradar-site here: the
# Device page reports a display service that is down, rather than failing to
# start because of one.
Environment=BOXRADAR_CONFIG_FEED=http://127.0.0.1:8081
ExecStart=/usr/bin/python3 -m boxradar_config --port 8082
Restart=always
RestartSec=5
# Below the display's feed. A shapely union while a board is polling should
# lose, and this service being slow costs nobody anything.
Nice=15

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectControlGroups=true
# The blob is published into lighttpd's document root, which is the one path
# outside this service's own directories that it may write.
ReadWritePaths=/var/www/html
RestrictAddressFamilies=AF_INET AF_INET6
# shapely unions over the whole UK dataset are the peak here, well above
# anything the METAR proxy does.
MemoryMax=512M

[Install]
WantedBy=multi-user.target
